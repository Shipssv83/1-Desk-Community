# ── DATABASE (PostgreSQL) ──
POSTGRES_DB=1-Desk
POSTGRES_USER=chatuser
POSTGRES_PASSWORD=chatpass
# Used by the backend directly (Docker compose builds this from the parts above).
DATABASE_URL=postgres://chatuser:chatpass@localhost:5433/1-Desk
REDIS_URL=redis://localhost:6379

# ── JWT AUTH ──
# Generate strong random strings: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate_a_64_character_hex_string_for_access_token_validation
JWT_REFRESH_SECRET=generate_another_64_character_hex_string_for_refresh_token_validation

# Key for encrypting integration credentials (Dify API keys) at rest.
# 32+ random chars. If empty, derives from JWT_SECRET.
INTEGRATION_ENC_KEY=

# ── SEED ADMIN USER (created on first start) ──
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password

# ── SYSTEM ──
PORT=4000
NODE_ENV=development
BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ── FRONTEND ──
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
