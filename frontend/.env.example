# Backend API base URL (no trailing slash)
VITE_API_URL="http://localhost:4000"

# Socket.io URL. Leave empty/unset in prod (nginx proxies /socket.io/ to the
# backend on the same origin). Set to the backend's own port for local dev,
# where frontend and backend run on different ports without a shared proxy.
VITE_SOCKET_URL="http://localhost:4000"

# Telegram Login Widget bot username (without @)
# Leave empty to hide the Telegram button
VITE_TELEGRAM_BOT_USERNAME=""
