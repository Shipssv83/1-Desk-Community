# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/1desk?schema=public"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-min-32-chars-random-string"
JWT_REFRESH_SECRET="change-me-min-32-chars-different-string"
# JWT_ACCESS_EXPIRES=15m
# JWT_REFRESH_EXPIRES=30d

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
BASE_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3001"
UPLOAD_DIR="/app/media"

# ── Seed admin account ────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-strong-password"

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Telegram Login Widget ─────────────────────────────────────────────────────
# Get token from @BotFather → /newbot
# Set domain in @BotFather → /setdomain
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
